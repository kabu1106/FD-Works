@@ -0,0 +1,76 @@
+import { AttendanceTimelineSlot } from '@/domain/attendance/attendanceTimelineSlot'
+import { OvertimeSlotResolvedProjection } from '../overtimeSlotResolvedProjection'
+
+describe('OvertimeSlotResolvedProjection', () => {
+  it('DUTY24の仮眠時間と部分的に重なる超勤は重なり部分のみ除外する', () => {
+    const projection = new OvertimeSlotResolvedProjection()
+
+    const slots: AttendanceTimelineSlot[] = [
+      {
+        dutyId: 'duty-1',
+        staffId: 10,
+        type: 'work',
+        startAt: '2026-02-01T07:00:00.000Z',
+        endAt: '2026-02-01T09:00:00.000Z',
+      },
+    ]
+
+    const result = projection.resolve(
+      slots,
+      '2026-02-01',
+      'DUTY24',
+      {
+        startAt: '2026-02-01T07:30:00.000Z',
+        endAt: '2026-02-01T08:30:00.000Z',
+      }
+    )
+
+    expect(result).toEqual([
+      {
+        dutyId: 'duty-1',
+        staffId: 10,
+        startAt: '2026-02-01T07:00:00.000Z',
+        endAt: '2026-02-01T07:30:00.000Z',
+      },
+    ])
+  })
+
+  it('仮眠時間が超勤区間の中間にある場合は前後2つに分割する', () => {
+    const projection = new OvertimeSlotResolvedProjection()
+
+    const slots: AttendanceTimelineSlot[] = [
+      {
+        dutyId: 'duty-2',
+        staffId: 20,
+        type: 'work',
+        startAt: '2026-02-02T07:00:00.000Z',
+        endAt: '2026-02-02T10:00:00.000Z',
+      },
+    ]
+
+    const result = projection.resolve(
+      slots,
+      '2026-02-02',
+      'DUTY24',
+      {
+        startAt: '2026-02-02T07:30:00.000Z',
+        endAt: '2026-02-02T08:15:00.000Z',
+      }
+    )
+
+    expect(result).toEqual([
+      {
+        dutyId: 'duty-2',
+        staffId: 20,
+        startAt: '2026-02-02T07:00:00.000Z',
+        endAt: '2026-02-02T07:30:00.000Z',
+      },
+      {
+        dutyId: 'duty-2',
+        staffId: 20,
+        startAt: '2026-02-02T08:15:00.000Z',
+        endAt: '2026-02-02T08:30:00.000Z',
+      },
+    ])
+  })
+})
